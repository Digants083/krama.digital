DATABASE_URL=
ADMIN1_EMAIL=
ADMIN1_CONFIRMATION_EMAIL=
ADMIN2_EMAIL=
ADMIN2_CONFIRMATION_EMAIL=

# JWT Secret for authentication
JWT_SECRET=

# Sarvam Saaras v3 speech-to-text (server-side only)
SARVAM_API_KEY=

# Local EHR draft generation through Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
EHR_MODEL=gpt-oss:20b
EHR_GENERATION_TIMEOUT_SECONDS=900
EHR_CONTEXT_WINDOW_TOKENS=32768
EHR_INITIAL_OUTPUT_TOKENS=3072
EHR_MAX_OUTPUT_TOKENS=6144

# SMTP Configuration for sending emails
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
SENDER_NAME=

# Background scheduler controls
BACKGROUND_JOBS_ENABLED=true
SCHEDULER_ACTIVE_POLL_SECONDS=60
SCHEDULER_IDLE_POLL_SECONDS=300

# to run backend use this command
#  uvicorn app.main:app --host 0.0.0.0 --port 8082 --reload
