DATABASE_URL=
ADMIN1_EMAIL=
ADMIN1_CONFIRMATION_EMAIL=
ADMIN2_EMAIL=
ADMIN2_CONFIRMATION_EMAIL=

# JWT Secret for authentication
JWT_SECRET=

# Bcrypt hash used to unlock the sensitive admin Data area.
ADMIN_DATA_PASSWORD_HASH=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://krama.digital,https://www.krama.digital

# Sarvam Saaras v3 speech-to-text (server-side only)
SARVAM_API_KEY=

# GPU EC2 #2 lifecycle (controlled by EC2 #1 through its IAM role)
GPU_INSTANCE_ID=
AWS_REGION=ap-south-1
GPU_IDLE_TIMEOUT=1200
GPU_STARTUP_TIMEOUT=900
GPU_READINESS_POLL_SECONDS=5

# Ollama running on GPU EC2 #2. Use its private VPC DNS name or private IP.
OLLAMA_BASE_URL=http://EC2-2-PRIVATE-DNS:11434
OLLAMA_MODEL=gpt-oss:20b
EHR_GENERATION_TIMEOUT_SECONDS=900
# Safe starting point for one dedicated 24 GB GPU.
EHR_GENERATION_CONCURRENCY=2
EHR_QUEUE_ESTIMATED_MINUTES_PER_JOB=5
EHR_QUEUE_POLL_SECONDS=2
EHR_CONTEXT_WINDOW_TOKENS=32768
EHR_INITIAL_OUTPUT_TOKENS=3072
EHR_MAX_OUTPUT_TOKENS=6144

# SMTP Configuration for sending emails
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
SENDER_NAME=

# Background scheduler controls
BACKGROUND_JOBS_ENABLED=true
SCHEDULER_ACTIVE_POLL_SECONDS=60
SCHEDULER_IDLE_POLL_SECONDS=300

# to run backend use this command
#  uvicorn app.main:app --host 0.0.0.0 --port 8082 --reload
